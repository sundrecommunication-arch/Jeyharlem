PORT=4000
ADMIN_KEY=change-this-key
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Optional: set this to switch persistence from the JSON file (server/data/db.json) to a
# real Postgres database. Leave unset and everything keeps working exactly as before.
# On first connection, if the products table is still empty, whatever is currently in
# server/data/db.json (your 30 real products, settings, etc.) is imported automatically.
# Any Postgres works — e.g. a free instance from neon.tech or supabase.com, or Hostinger's
# own database if your plan includes Postgres.
DATABASE_URL=postgres://user:password@host:5432/dbname
